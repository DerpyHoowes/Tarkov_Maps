        "marker.fb205e6bf8fb4be6bda2f092f64f0b6f.description": "\u0412\u0442\u043E\u0440\u043E\u0439 \u044D\u0442\u0430\u0436 \u0432 \u0437\u0434\u0430\u043D\u0438\u0438 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0438, \u043A\u0430\u0431\u0438\u043D\u0435\u0442 \u0437\u0430 \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u043C\u0438 \u0434\u0432\u0435\u0440\u044C\u043C\u0438, \u0432 \u043A\u0443\u0447\u0435 \u0441\u0432\u0430\u043B\u0438\u0432\u0448\u0438\u0445\u0441\u044F \u0441 \u043F\u043E\u043B\u043A\u0438 \u043A\u043D\u0438\u0433.",
        "marker.08bf3effa44c45b790773c635b528a35.name": "\u041F\u0440\u043E\u0435\u043A\u0442\u043D\u0430\u044F \u0434\u043E\u043A. \u0432 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0435",
